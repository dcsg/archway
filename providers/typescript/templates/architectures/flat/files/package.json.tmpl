{
  "name": "{{.PackageName}}",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">={{.NodeVersion}}.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^{{.NodeVersion}}",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  }
}
