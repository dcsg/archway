{{- if .HasFeatureFlags}}
package featureflags

import (
	"context"
	"log/slog"
	"os"
	"strconv"
	"strings"
)

// EnvConfig holds configuration for the environment variable provider.
type EnvConfig struct {
	// Prefix is prepended to flag names when reading environment variables.
	// Default: "FF_". A flag named "dark_mode" reads FF_DARK_MODE.
	Prefix string
}

// EnvProvider reads feature flags from environment variables.
// Flag names are converted to UPPER_SNAKE_CASE with a configurable prefix.
type EnvProvider struct {
	prefix string
	logger *slog.Logger
}

// NewEnvProvider creates an environment variable provider.
func NewEnvProvider(cfg EnvConfig, logger *slog.Logger) *EnvProvider {
	prefix := cfg.Prefix
	if prefix == "" {
		prefix = "FF_"
	}
	return &EnvProvider{
		prefix: prefix,
		logger: logger.With("component", "featureflags.env"),
	}
}

// BooleanValue reads a boolean flag from environment variables.
// Truthy: "true", "1", "yes", "on". Falsy: "false", "0", "no", "off".
// Returns defaultValue when the env var is unset or has an unrecognized value.
func (p *EnvProvider) BooleanValue(_ context.Context, flag string, defaultValue bool) bool {
	raw, ok := p.lookup(flag)
	if !ok {
		return defaultValue
	}
	switch strings.ToLower(raw) {
	case "true", "1", "yes", "on":
		return true
	case "false", "0", "no", "off":
		return false
	default:
		p.logger.Warn("unrecognized boolean flag value, using default",
			"flag", flag, "value", raw, "default", defaultValue)
		return defaultValue
	}
}

// StringValue reads a string flag from environment variables.
// Returns defaultValue when the env var is unset.
func (p *EnvProvider) StringValue(_ context.Context, flag string, defaultValue string) string {
	raw, ok := p.lookup(flag)
	if !ok {
		return defaultValue
	}
	return raw
}

// IntValue reads an integer flag from environment variables.
// Returns defaultValue when the env var is unset or cannot be parsed.
func (p *EnvProvider) IntValue(_ context.Context, flag string, defaultValue int64) int64 {
	raw, ok := p.lookup(flag)
	if !ok {
		return defaultValue
	}
	v, err := strconv.ParseInt(raw, 10, 64)
	if err != nil {
		p.logger.Warn("invalid integer flag value, using default",
			"flag", flag, "value", raw, "default", defaultValue, "error", err)
		return defaultValue
	}
	return v
}

// FloatValue reads a float flag from environment variables.
// Returns defaultValue when the env var is unset or cannot be parsed.
func (p *EnvProvider) FloatValue(_ context.Context, flag string, defaultValue float64) float64 {
	raw, ok := p.lookup(flag)
	if !ok {
		return defaultValue
	}
	v, err := strconv.ParseFloat(raw, 64)
	if err != nil {
		p.logger.Warn("invalid float flag value, using default",
			"flag", flag, "value", raw, "default", defaultValue, "error", err)
		return defaultValue
	}
	return v
}

// Shutdown is a no-op for the environment variable provider.
func (p *EnvProvider) Shutdown(_ context.Context) error {
	return nil
}

// lookup converts a flag name to an environment variable name and reads it.
func (p *EnvProvider) lookup(flag string) (string, bool) {
	envKey := p.prefix + strings.ToUpper(strings.ReplaceAll(flag, "-", "_"))
	return os.LookupEnv(envKey)
}
{{- end}}
