{{- if .Partials}}{{if index .Partials "main_wire"}}
{{- range index .Partials "main_wire"}}
	{{.}}
{{- end}}
{{- end}}{{end}}

	// Build application lifecycle.
	app := lifecycle.New(logger)
{{- if .Partials}}{{if index .Partials "main_register"}}
{{range index .Partials "main_register"}}
	{{.}}
{{- end}}
{{- end}}{{end}}

	// Register shutdown hooks (reverse dependency order).
{{- if .Partials}}{{if index .Partials "main_shutdown"}}
{{- range index .Partials "main_shutdown"}}
	{{.}}
{{- end}}
{{- end}}{{end}}
	app.OnShutdown("otel", lifecycle.ShutdownFunc(otelShutdown))

	logger.Info("starting {{.ServiceName}}",
		"version", version,
		"environment", cfg.App.Environment,
	)

	return app.Run(ctx)
}
